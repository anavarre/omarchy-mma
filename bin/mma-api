#!/usr/bin/env bash
# Fetches MMA data from ESPN's public (unofficial, keyless) API and prints JSON
# on stdout. Run by Service.qml, which parses the output with Model.js.
#
#   mma-api events <league> <YYYYMMDD-YYYYMMDD>
#       The scoreboard for the date range: events, fights and fighters.
#   mma-api card <league> <eventId> <competitionId>...
#       A JSON array with one core-API competition per id. This is where the
#       card segment (main, prelims1, prelims2) lives; the scoreboard has none.
#       An id written with a trailing "+" (finished fight) also adds that
#       fight's status object, which names how it was won (KO, decision...).
#
#   mma-api wiki <cw|ksw|oktagon|aca> <year>...
#       Cage Warriors has no ESPN coverage worth using and its own site sits
#       behind a bot challenge; ESPN's KSW feed stops in December 2024. So their
#       schedules and cards come from Wikipedia's "<year> in Cage Warriors",
#       "<year> in Konfrontacja Sztuk Walki" and "<year> in Oktagon MMA" and "<year> in Absolute Championship Akhmat" pages, fetched through the MediaWiki API. A JSON
#       array of the API's answers, one per year; years whose request fails are
#       left out, and it exits 1 when none came through. Model.js reads the wikitext.
#
#   mma-api ares <days>
#       ARES Fighting Championship (France) is on neither ESPN nor Wikipedia, so
#       its schedule comes from the promotion's own site: the upcoming-events
#       listing, each upcoming event's "Fight Card" page, the past-events
#       listing and the result page of every past event of the last <days>
#       days (at most MAX_ARES_PAST). One JSON object holding those pages as
#       strings: {"upcoming", "past", "cards": {competitionId: html},
#       "results": {path: html}}. Model.js reads the HTML. It exits 1 when
#       neither listing came through.
#
#   mma-api sherdog <hxmma> <days>
#       Hexagone MMA (France) is on neither ESPN nor Wikipedia, so its schedule
#       comes from its Sherdog organization page: the upcoming and recent event
#       tabs, plus the page of each upcoming event (at most MAX_SHERDOG_UPCOMING)
#       and of each event of the last <days> days (at most MAX_SHERDOG_PAST).
#       One JSON object: {"org": html, "events": {path: html}}. Model.js reads
#       the HTML. It exits 1 when the organization page did not come through.
#
#   mma-api records <name>...
#       Wikipedia's cards carry no fight records, so the fighters' W-L-D come
#       from Sherdog's fighter pages. A JSON object mapping every name to e.g.
#       "10-1-0" (or "34-11-0 (1 NC)"), to "n/a" when Sherdog answered but has
#       no usable record, or to "blocked" when it did not answer properly. A
#       name is looked up only when Sherdog has exactly one fighter by it: a
#       namesake gets "n/a" rather than someone else's record. It exits 1 when
#       every name came back "blocked".
#
# MMA_SITE_BASE, MMA_CORE_BASE, MMA_WIKI_API, MMA_ARES_BASE and MMA_SHERDOG_BASE override the endpoints for running the
# script by hand. They must be https: curl refuses every other scheme, and
# Service.qml does not pass them through from the shell's environment.
set -u -o pipefail

SITE_BASE=${MMA_SITE_BASE:-https://site.api.espn.com/apis/site/v2/sports/mma}
CORE_BASE=${MMA_CORE_BASE:-https://sports.core.api.espn.com/v2/sports/mma/leagues}
WIKI_API=${MMA_WIKI_API:-https://en.wikipedia.org/w/api.php}
SHERDOG_BASE=${MMA_SHERDOG_BASE:-https://www.sherdog.com}
ARES_BASE=${MMA_ARES_BASE:-https://www.aresfighting.com}
# Wikimedia asks API clients to say who they are.
WIKI_UA="omarchy-mma (https://github.com/anavarre/omarchy-mma)"
PARALLEL=16
# A card has at most about 15 fights; never make more requests than this for
# one event, whatever the scoreboard listed.
MAX_FIGHTS=40
# Pages fetched for ARES: card pages of upcoming events, result pages of past ones.
MAX_ARES_UPCOMING=8
MAX_ARES_PAST=6
MAX_SHERDOG_UPCOMING=8
MAX_SHERDOG_PAST=6
# ESPN's largest answer is well under 1 MB; refuse anything far beyond that.
MAX_BYTES=8388608

# --max-filesize only works when the server announces a length, so the body is
# also cut at the limit: head stops reading, curl fails on the closed pipe and
# pipefail makes that the function's status. The truncated output is then
# ignored: Service.qml reads stdout only on exit 0, and `card` deletes the file.
fetch() {
  curl -fsS --proto '=https' --max-filesize "$MAX_BYTES" --max-time 20 --retry 1 \
    -A "${2:-omarchy-mma}" "$1" | head -c "$MAX_BYTES"
}

urlencode() {
  local LC_ALL=C s=$1 i c out=""
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      [A-Za-z0-9._~-]) out+=$c ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

# Prints stdin as a JSON string. Control characters other than tab and newline
# are dropped (they are not valid in JSON); the rest is escaped.
jstr() {
  LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\r$//' \
    | awk 'BEGIN { printf "\"" } { printf "%s\\n", $0 } END { printf "\"" }'
}

# Lower-case ASCII form of a name, so "Jose" matches "José" and HTML entities
# in Sherdog's markup compare equal to the plain apostrophe in Wikipedia's.
norm() {
  printf '%s' "$1" | sed "s/&#0*39;/'/g;s/&amp;/\&/g;s/&quot;/\"/g" \
    | iconv -f utf-8 -t ascii//TRANSLIT 2> /dev/null | tr '[:upper:]' '[:lower:]' | tr -s ' '
}

# Prints what Sherdog says about the fighter called $1: "W-L-D" (plus " (n NC)")
# for a record, "n/a" when Sherdog answered but has no usable record (no such
# fighter, several by that name, or a page without one), and "blocked" when it
# did not answer properly: a refused request, an error, or a bot-challenge page.
record_of() {
  local want html rows path page w l d nc
  want=$(norm "$1")
  html=$(fetch "$SHERDOG_BASE/stats/fightfinder?SearchTxt=$(urlencode "$1")" "$WIKI_UA") || { printf 'blocked'; return; }
  # Every real search page, results or not, carries the search form.
  grep -q 'name="SearchTxt"' <<< "$html" || { printf 'blocked'; return; }
  rows=$(printf '%s' "$html" | grep -o '<td><a href="/fighter/[^"]*">[^<]*</a></td>' \
    | sed -E 's|<td><a href="([^"]*)">([^<]*)</a></td>|\1\t\2|')
  path=$(
    while IFS=$'\t' read -r p label; do
      [ "$(norm "$label")" = "$want" ] && printf '%s\n' "$p"
    done <<< "$rows" | sort -u
  )
  # Zero or several fighters by this name: no record rather than a wrong one.
  if [ -z "$path" ] || [ "$(printf '%s\n' "$path" | wc -l)" -ne 1 ] || ! [[ $path =~ ^/fighter/[A-Za-z0-9._-]+$ ]]; then
    printf 'n/a'; return
  fi
  page=$(fetch "$SHERDOG_BASE$path" "$WIKI_UA" | tr -d '\n') || { printf 'blocked'; return; }
  count() {
    printf '%s' "$page" | grep -o "class=\"winloses $1\">[[:space:]]*<span>[^<]*</span>[[:space:]]*<span>[0-9]*" \
      | grep -o '[0-9]\+$' | head -1
  }
  # Wins always show; the other rows only appear when not zero.
  w=$(count win)
  [ -n "$w" ] || { printf 'n/a'; return; }
  l=$(count lose); d=$(count draws); nc=$(count nc)
  printf '%s-%s-%s' "$w" "${l:-0}" "${d:-0}"
  [ "${nc:-0}" -gt 0 ] && printf ' (%s NC)' "$nc"
  return 0
}

die() { echo "mma-api: $*" >&2; exit 2; }

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
  events)
    [ $# -eq 2 ] || die "usage: events <league> <dates>"
    [[ $1 =~ ^[a-z0-9-]+$ ]] || die "bad league"
    [[ $2 =~ ^[0-9]{8}-[0-9]{8}$ ]] || die "bad dates"
    fetch "$SITE_BASE/$1/scoreboard?dates=$2&limit=100"
    ;;
  card)
    [ $# -ge 3 ] || die "usage: card <league> <eventId> <competitionId>..."
    [[ $1 =~ ^[a-z0-9-]+$ ]] || die "bad league"
    [[ $2 =~ ^[0-9]+$ ]] || die "bad event"
    league=$1 event=$2
    shift 2
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    n=0
    for arg in "$@"; do
      id=${arg%+}
      [[ $id =~ ^[0-9]+$ ]] || continue
      [ "$n" -lt "$MAX_FIGHTS" ] || break
      n=$((n + 1))
      # A failed or oversized fetch leaves no file, so it is skipped below.
      { fetch "$CORE_BASE/$league/events/$event/competitions/$id?lang=en" > "$tmp/$n.json" 2> /dev/null \
          || rm -f "$tmp/$n.json"; } &
      if [ "$id" != "$arg" ]; then
        { fetch "$CORE_BASE/$league/events/$event/competitions/$id/status?lang=en" > "$tmp/$n.s.json" 2> /dev/null \
            || rm -f "$tmp/$n.s.json"; } &
      fi
      # Throttle: wait for the batch to finish before starting the next.
      if [ $((n % PARALLEL)) -eq 0 ]; then wait; fi
    done
    wait
    printf '['
    sep=""
    for ((i = 1; i <= n; i++)); do
      for f in "$tmp/$i.json" "$tmp/$i.s.json"; do
        [ -s "$f" ] || continue
        printf '%s' "$sep"
        cat "$f"
        sep=","
      done
    done
    printf ']'
    ;;
  wiki)
    [ $# -ge 2 ] && [ $# -le 5 ] || die "usage: wiki <cw|ksw|oktagon|aca> <year>..."
    case "$1" in
      cw) wiki_page=Cage_Warriors ;;
      ksw) wiki_page=Konfrontacja_Sztuk_Walki ;;
      oktagon) wiki_page=Oktagon_MMA ;;
      aca) wiki_page=Absolute_Championship_Akhmat ;;
      *) die "bad organization" ;;
    esac
    shift
    for y in "$@"; do [[ $y =~ ^20[0-9]{2}$ ]] || die "bad year"; done
    printf '['
    sep=""
    ok=0
    for y in "$@"; do
      out=$(fetch "$WIKI_API?action=parse&page=${y}_in_${wiki_page}&prop=wikitext&redirects=1&format=json&formatversion=2" "$WIKI_UA" 2> /dev/null) || continue
      [ -n "$out" ] || continue
      printf '%s%s' "$sep" "$out"
      sep=","
      ok=1
    done
    printf ']'
    [ "$ok" -eq 1 ] || exit 1
    ;;
  ares)
    [ $# -eq 1 ] && [[ $1 =~ ^[0-9]{1,4}$ ]] || die "usage: ares <days>"
    back=$1
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    ok=0
    fetch "$ARES_BASE/events/?filter=upcoming" > "$tmp/upcoming" 2> /dev/null && [ -s "$tmp/upcoming" ] && ok=1 || : > "$tmp/upcoming"
    fetch "$ARES_BASE/events/?filter=past" > "$tmp/past" 2> /dev/null && [ -s "$tmp/past" ] && ok=1 || : > "$tmp/past"
    [ "$ok" -eq 1 ] || exit 1
    # Upcoming events: the listing links each one's card as ?competition=<id>.
    ids=$(grep -oE '\?competition=[0-9]{1,9}' "$tmp/upcoming" | sed 's/.*=//' | awk '!seen[$0]++' | head -n "$MAX_ARES_UPCOMING")
    # Past events: href and date of every entry, newest first, kept while the
    # date is within the window.
    cutoff=$(date -u -d "-$back days" +%Y%m%d 2> /dev/null) || cutoff=00000000
    paths=$(tr '\n' ' ' < "$tmp/past" \
      | grep -oE 'competition-resume past" +href="https://www\.aresfighting\.com/[A-Za-z0-9_-]+/"|<p class="date">[0-9]{2}/[0-9]{2}/[0-9]{4}' \
      | sed -E 's|.*aresfighting\.com(/[^"]*)"|\1|; s|.*>||' | paste -d' ' - - \
      | while read -r path d; do
          [[ $path =~ ^/[A-Za-z0-9_-]+/$ ]] && [[ $d =~ ^([0-9]{2})/([0-9]{2})/([0-9]{4})$ ]] || continue
          [ "${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}" -ge "$cutoff" ] && printf '%s\n' "$path"
        done | head -n "$MAX_ARES_PAST")
    n=0
    for id in $ids; do
      n=$((n + 1))
      { fetch "$ARES_BASE/events/?competition=$id" > "$tmp/card.$id" 2> /dev/null || rm -f "$tmp/card.$id"; } &
      if [ $((n % PARALLEL)) -eq 0 ]; then wait; fi
    done
    wait
    n=0
    for path in $paths; do
      n=$((n + 1))
      key=${path//\//_}
      { fetch "$ARES_BASE$path" > "$tmp/result.$key" 2> /dev/null || rm -f "$tmp/result.$key"; } &
      if [ $((n % PARALLEL)) -eq 0 ]; then wait; fi
    done
    wait
    printf '{"upcoming":'; jstr < "$tmp/upcoming"
    printf ',"past":'; jstr < "$tmp/past"
    printf ',"cards":{'
    sep=""
    for id in $ids; do
      [ -s "$tmp/card.$id" ] || continue
      printf '%s"%s":' "$sep" "$id"; jstr < "$tmp/card.$id"
      sep=","
    done
    printf '},"results":{'
    sep=""
    for path in $paths; do
      key=${path//\//_}
      [ -s "$tmp/result.$key" ] || continue
      printf '%s"%s":' "$sep" "$path"; jstr < "$tmp/result.$key"
      sep=","
    done
    printf '}}'
    ;;
  sherdog)
    [ $# -eq 2 ] && [ "$1" = "hxmma" ] && [[ $2 =~ ^[0-9]{1,4}$ ]] || die "usage: sherdog <hxmma> <days>"
    back=$2
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    fetch "$SHERDOG_BASE/organizations/Hexagone-MMA-16693" "$WIKI_UA" > "$tmp/org" 2> /dev/null && [ -s "$tmp/org" ] || exit 1
    flat=$(tr '\n\r' '  ' < "$tmp/org")
    # The page holds both tabs; each row names the event's path and its day.
    rows() {
      grep -oE "document\.location='/events/[A-Za-z0-9_-]+'|itemprop=\"startDate\" content=\"[0-9]{4}-[0-9]{2}-[0-9]{2}" \
        | sed -E "s|.*location='(/events/[^']*)'|\1|; s|.*content=\"||" | paste -d' ' - - 
    }
    upcoming_html=${flat#*id=\"upcoming_tab\"}
    recent_html=${upcoming_html#*id=\"recent_tab\"}
    upcoming_html=${upcoming_html%%id=\"recent_tab\"*}
    paths=$(printf '%s' "$upcoming_html" | rows | awk '{print $1}' | head -n "$MAX_SHERDOG_UPCOMING")
    cutoff=$(date -u -d "-$back days" +%Y-%m-%d 2> /dev/null) || cutoff=0000-00-00
    past=$(printf '%s' "$recent_html" | rows | while read -r path d; do
        [[ $path =~ ^/events/[A-Za-z0-9_-]+$ ]] && [[ $d > $cutoff || $d == "$cutoff" ]] && printf '%s\n' "$path"
      done | head -n "$MAX_SHERDOG_PAST")
    paths=$(printf '%s\n%s\n' "$paths" "$past" | grep -E '^/events/[A-Za-z0-9_-]+$' | awk '!seen[$0]++')
    n=0
    for path in $paths; do
      n=$((n + 1))
      key=${path//\//_}
      { fetch "$SHERDOG_BASE$path" "$WIKI_UA" > "$tmp/event.$key" 2> /dev/null || rm -f "$tmp/event.$key"; } &
      if [ $((n % PARALLEL)) -eq 0 ]; then wait; fi
    done
    wait
    printf '{"org":'; jstr < "$tmp/org"
    printf ',"events":{'
    sep=""
    for path in $paths; do
      key=${path//\//_}
      [ -s "$tmp/event.$key" ] || continue
      printf '%s"%s":' "$sep" "$path"; jstr < "$tmp/event.$key"
      sep=","
    done
    printf '}}'
    ;;
  records)
    [ $# -ge 1 ] && [ $# -le $((MAX_FIGHTS * 2)) ] || die "usage: records <name>..."
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    n=0
    for name in "$@"; do
      [ "${#name}" -le 60 ] && [[ $name != *[[:cntrl:]]* ]] && [ -n "$name" ] || continue
      n=$((n + 1))
      printf '%s' "$name" > "$tmp/$n.name"
      { record_of "$name" > "$tmp/$n.rec" 2> /dev/null; } &
      if [ $((n % PARALLEL)) -eq 0 ]; then wait; fi
    done
    wait
    printf '{'
    sep=""
    ok=0
    for ((i = 1; i <= n; i++)); do
      # A lookup that died without answering counts as blocked.
      [ -s "$tmp/$i.rec" ] || printf 'blocked' > "$tmp/$i.rec"
      [ "$(cat "$tmp/$i.rec")" = "blocked" ] || ok=1
      key=$(sed 's/\\/\\\\/g;s/"/\\"/g' "$tmp/$i.name")
      printf '%s"%s":"%s"' "$sep" "$key" "$(cat "$tmp/$i.rec")"
      sep=","
    done
    printf '}'
    [ "$ok" -eq 1 ] || exit 1
    ;;
  *)
    die "usage: mma-api events|card|wiki|ares|sherdog|records ..."
    ;;
esac
