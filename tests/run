#!/usr/bin/env bash
# Runs every portable check: Model.js unit tests against saved ESPN, Wikipedia and ARES responses,
# a syntax and argument check of bin/mma-api, bin/mma-paste against a fake
# wl-paste, and SearchField.qml's paste routing under qmltestrunner. None of it needs Omarchy, a
# display or the network.
set -u
cd "$(dirname "$0")/.." || exit 1
failed=""
echo "== Model.js"; node --test tests/model.test.js > /dev/null 2>&1 && echo ok || { node --test tests/model.test.js; failed="$failed model"; }
echo "== bin/mma-api"
bash -n bin/mma-api \
  && ! bin/mma-api events 'x;y' 20261029-20261120 > /dev/null 2>&1 \
  && ! bin/mma-api events ufc 'nope' > /dev/null 2>&1 \
  && ! bin/mma-api card ufc 'abc' 1 > /dev/null 2>&1 \
  && ! bin/mma-api wiki > /dev/null 2>&1 \
  && ! bin/mma-api wiki 2026 > /dev/null 2>&1 \
  && ! bin/mma-api wiki nope 2026 > /dev/null 2>&1 \
  && ! bin/mma-api wiki cw '2026;x' > /dev/null 2>&1 \
  && ! bin/mma-api wiki cw 1999 > /dev/null 2>&1 \
  && ! bin/mma-api ares > /dev/null 2>&1 \
  && ! bin/mma-api ares 'x;y' > /dev/null 2>&1 \
  && ! bin/mma-api sherdog > /dev/null 2>&1 \
  && ! bin/mma-api sherdog nope 30 > /dev/null 2>&1 \
  && ! bin/mma-api sherdog hxmma 'x;y' > /dev/null 2>&1 \
  && ! MMA_SHERDOG_BASE=http://127.0.0.1:9 bin/mma-api sherdog hxmma 30 > /dev/null 2>&1 \
  && ! MMA_SHERDOG_BASE=file:///etc bin/mma-api sherdog hxmma 30 > /dev/null 2>&1 \
  && ! bin/mma-api official > /dev/null 2>&1 \
  && ! bin/mma-api official nope > /dev/null 2>&1 \
  && ! MMA_PFL_BASE=http://127.0.0.1:9 bin/mma-api official pfl > /dev/null 2>&1 \
  && ! MMA_PFL_BASE=file:///etc bin/mma-api official pfl > /dev/null 2>&1 \
  && ! MMA_UFC_BASE=http://127.0.0.1:9 MMA_UFC_CRAWL_DELAY=0 bin/mma-api official ufc > /dev/null 2>&1 \
  && ! MMA_UFC_BASE=file:///etc MMA_UFC_CRAWL_DELAY=0 bin/mma-api official ufc > /dev/null 2>&1 \
  && ! bin/mma-api records > /dev/null 2>&1 \
  && ! MMA_SHERDOG_BASE=http://127.0.0.1:9 bin/mma-api records 'Nik Bagley' > /dev/null 2>&1 \
  && ! MMA_SHERDOG_BASE=file:///etc bin/mma-api records 'Nik Bagley' > /dev/null 2>&1 \
  && ! MMA_WIKI_API=http://127.0.0.1:9 bin/mma-api wiki ksw 2026 > /dev/null 2>&1 \
  && ! MMA_WIKI_API=file:///etc bin/mma-api wiki ksw 2026 > /dev/null 2>&1 \
  && ! MMA_ARES_BASE=http://127.0.0.1:9 bin/mma-api ares 30 > /dev/null 2>&1 \
  && ! MMA_ARES_BASE=file:///etc bin/mma-api ares 30 > /dev/null 2>&1 \
  && ! MMA_SITE_BASE=http://127.0.0.1:9 bin/mma-api events ufc 20261029-20261120 > /dev/null 2>&1 \
  && ! MMA_SITE_BASE=file:///etc bin/mma-api events ufc 20261029-20261120 > /dev/null 2>&1 \
  && [ "$(MMA_CORE_BASE=https://127.0.0.1:9 bin/mma-api card ufc 1 2 '3+' 2> /dev/null)" = "[]" ] \
  && ! MMA_ARES_BASE=https://127.0.0.1:9 bin/mma-api ares 30 > /dev/null 2>&1 \
  && ! MMA_SHERDOG_BASE=https://127.0.0.1:9 bin/mma-api sherdog hxmma 30 > /dev/null 2>&1 \
  && echo ok || failed="$failed api"
echo "== bin/mma-paste"; bash -n bin/mma-paste && bash tests/paste.sh || failed="$failed paste"
echo "== SearchField.qml"
# Real key and mouse delivery against Qt's own TextField, offscreen. Skipped
# when Qt's test runner is not installed, except under CI.
qmltest=""
for c in /usr/lib/qt6/bin/qmltestrunner qmltestrunner6; do command -v "$c" > /dev/null 2>&1 && { qmltest=$c; break; }; done
if [ -n "$qmltest" ]; then
  out=$(QT_QPA_PLATFORM=offscreen "$qmltest" -import tests/qml/imports -input tests/qml/tst_searchfield.qml 2>&1)
  if [ $? -eq 0 ] && printf '%s' "$out" | grep -q ' 0 failed'; then echo ok; else printf '%s\n' "$out"; failed="$failed searchfield"; fi
elif [ -n "${CI:-}" ]; then echo "qmltestrunner is not installed"; failed="$failed searchfield"
else echo "skipped: qmltestrunner is not installed"; fi
[ -z "$failed" ] && echo "ALL PASSED" || { echo "FAILED:$failed"; exit 1; }
